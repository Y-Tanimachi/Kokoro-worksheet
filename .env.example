# このファイルをコピーして .env.local を作成し、各値を埋めてください。
# .env.local は .gitignore 済みでコミットされません。

# --- Gemini API（AIのひと言メッセージ生成 / サーバー専用） ---
# Google AI Studio で取得: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Firebase Admin SDK（サーバー専用・秘密鍵を含む。絶対に公開しないこと） ---
# Firebase コンソール > プロジェクト設定 > サービスアカウント > 新しい秘密鍵を生成 で取得
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 秘密鍵は改行を \n リテラルに置換した1行の文字列として設定する（コード側で実改行へ復元）
# 例: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- プッシュ通知（クライアント公開 / VAPID 公開鍵） ---
# Firebase コンソール > プロジェクト設定 > Cloud Messaging > ウェブプッシュ証明書 で生成
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- 通知バッチ（GitHub Actions のクロンジョブ認証用の共有シークレット） ---
# 十分に長いランダム文字列を設定し、GitHub リポジトリの Secrets(CRON_SECRET) と一致させる
CRON_SECRET=
